<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import com.safora.client.components.MapViewComponent?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:id="rootPane" fx:controller="com.safora.client.controllers.RouteRecommendationController" style="-fx-background-color: #F8F2E7;">
    
    <!-- Map Background -->
    <MapViewComponent fx:id="mapView" />

    <!-- Overlay UI -->
    <HBox pickOnBounds="false" spacing="20">
        <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
        
        <!-- Left Side: Timeline / Back Button -->
        <VBox spacing="20" pickOnBounds="false">
            <Button text="← Back" onAction="#handleBack" styleClass="secondary-button" style="-fx-background-color: #FFFDF8;"/>
            
            <VBox styleClass="floating-panel" spacing="15" visible="true">
                <Label text="Checkpoints" styleClass="subtitle" style="-fx-font-weight: bold; -fx-text-fill: #6F2C2F;"/>
                <VBox fx:id="timelineContainer" spacing="10">
                    <!-- Populated dynamically -->
                </VBox>
            </VBox>
        </VBox>

        <Region HBox.hgrow="ALWAYS" pickOnBounds="false"/>

        <!-- Right Side: Route Cards -->
        <VBox alignment="BOTTOM_RIGHT" pickOnBounds="false" spacing="15">
            
            <HBox spacing="10" alignment="BOTTOM_RIGHT">
                <Label text="Select Route" styleClass="title" style="-fx-font-size: 20px; -fx-text-fill: #6F2C2F; -fx-background-color: #FFFDF8; -fx-padding: 8px 16px; -fx-background-radius: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);"/>
            </HBox>
            


            <VBox fx:id="routeCardsContainer" spacing="20" alignment="BOTTOM_RIGHT">
                <!-- Cards will be populated dynamically -->
            </VBox>
            
            <VBox styleClass="floating-panel" spacing="15" minWidth="350">
                <Label text="Route Highlights" styleClass="subtitle" style="-fx-font-weight: bold;"/>
                <FlowPane fx:id="reasonsContainer" hgap="8" vgap="8" />
                <Button text="Know More" onAction="#handleOpenModal" style="-fx-background-color: transparent; -fx-text-fill: #6F2C2F; -fx-cursor: hand; -fx-underline: true; -fx-padding: 0;"/>
                <Button text="Start Journey" onAction="#handleStartJourney" maxWidth="Infinity" styleClass="primary-button" style="-fx-padding: 14px 20px;"/>
            </VBox>
        </VBox>
    </HBox>

    <!-- Safety Analysis Modal -->
    <StackPane fx:id="safetyModal" style="-fx-background-color: rgba(0,0,0,0.6);" visible="false">
        <VBox style="-fx-background-color: #FFFDF8; -fx-background-radius: 12px; -fx-padding: 25;" maxWidth="500" maxHeight="500" spacing="15">
            <HBox alignment="CENTER_LEFT">
                <Label text="Why this route?" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #6F2C2F;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 16px; -fx-text-fill: #666;" onAction="#handleCloseModal"/>
            </HBox>
            
            <Label text="Safora recommends this route because it offers the safest overall journey based on current road conditions and live community information." wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #666; -fx-line-spacing: 2px;"/>
            
            <Label text="────────────────────────────────────────────────" style="-fx-text-fill: #EAEAEA; -fx-alignment: center;"/>
            
            <Label text="Route Summary" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C2C2C;"/>
            <HBox spacing="15">
                <VBox>
                    <Label text="Safety" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                    <Label fx:id="modalSafetyScore" text="" style="-fx-text-fill: #10B981; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                </VBox>
                <VBox>
                    <Label text="Distance" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                    <Label fx:id="modalDistance" text="" style="-fx-text-fill: #2C2C2C; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                </VBox>
                <VBox>
                    <Label text="Est. Time" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                    <Label fx:id="modalEstimatedTime" text="" style="-fx-text-fill: #2C2C2C; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                </VBox>
                <VBox>
                    <Label text="Mode" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                    <Label fx:id="modalModeText" text="" style="-fx-text-fill: #2C2C2C; -fx-font-weight: bold; -fx-font-size: 16px;"/>
                </VBox>
            </HBox>
            
            <Label text="────────────────────────────────────────────────" style="-fx-text-fill: #EAEAEA; -fx-alignment: center;"/>
            
            <Label text="Advantages" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C2C2C;"/>
            <Label fx:id="modalReasonText" wrapText="true" text="" style="-fx-text-fill: #666; -fx-font-size: 13px; -fx-padding: 0 0 0 10;"/>
            
            <Label text="────────────────────────────────────────────────" style="-fx-text-fill: #EAEAEA; -fx-alignment: center;"/>
            
            <Label text="Trade-off(s)" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C2C2C;"/>
            <HBox spacing="20">
                <VBox spacing="5" fx:id="tradeoffCol1">
                    <Label fx:id="tradeoffCol1Title" text="Fastest Route" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                    <Label fx:id="tradeoffCol1Val1" text="26 min" style="-fx-text-fill: #2C2C2C; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Label fx:id="tradeoffCol1Val2" text="75% Safety" style="-fx-text-fill: #F59E0B; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="5" fx:id="tradeoffCol2">
                    <Label fx:id="tradeoffCol2Title" text="Recommended Route" style="-fx-text-fill: #666; -fx-font-size: 12px;"/>
                    <Label fx:id="tradeoffCol2Val1" text="30 min" style="-fx-text-fill: #2C2C2C; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Label fx:id="tradeoffCol2Val2" text="94% Safety" style="-fx-text-fill: #10B981; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                </VBox>
                <VBox spacing="5" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" fx:id="tradeoffCol3">
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label fx:id="tradeoffCol3Val1" text="+4 min" style="-fx-text-fill: #F59E0B; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <Label fx:id="tradeoffCol3Val2" text="+19% Safety" style="-fx-text-fill: #10B981; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
            
            <Label text="────────────────────────────────────────────────" style="-fx-text-fill: #EAEAEA; -fx-alignment: center;"/>
            
            <HBox spacing="30" alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Decision Confidence" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                    <Label fx:id="modalConfidence" text="" style="-fx-text-fill: #2C2C2C; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </VBox>
                <VBox>
                    <Label text="Updated" style="-fx-font-size: 12px; -fx-text-fill: #666;"/>
                    <Label fx:id="modalLastUpdated" text="" style="-fx-text-fill: #2C2C2C; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>
        </VBox>
    </StackPane>

    <!-- Transition Overlay -->
    <StackPane fx:id="transitionOverlay" style="-fx-background-color: #6F2C2F;" visible="false">
        <VBox alignment="CENTER" spacing="20">
            <Label fx:id="transitionText" text="Preparing safest route..." style="-fx-font-size: 24px; -fx-text-fill: #FFFDF8; -fx-font-weight: bold;"/>
            <ProgressIndicator style="-fx-progress-color: #FFFDF8;" />
        </VBox>
    </StackPane>
</StackPane>
