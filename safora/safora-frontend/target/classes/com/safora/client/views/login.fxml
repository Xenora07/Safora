<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:id="rootPane" fx:controller="com.safora.client.controllers.LoginController" style="-fx-background-color: #F8F2E7;">
    <HBox>
        <!-- Left Side: Branding & Features -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="30" style="-fx-background-color: linear-gradient(to bottom right, #6F2C2F, #451B1D); -fx-padding: 80px;">
            <VBox spacing="10">
                <Label text="Safora" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
                <Label text="Navigate Smarter. Arrive Safer." style="-fx-font-size: 20px; -fx-text-fill: #E7DCCF;"/>
            </VBox>
            
            <VBox spacing="20" style="-fx-padding: 40 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Circle radius="20" fill="#FFFDF8" opacity="0.1"/>
                    <Label text="Context-Aware Routing" style="-fx-font-size: 16px; -fx-text-fill: #FFFDF8; -fx-font-weight: bold;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Circle radius="20" fill="#FFFDF8" opacity="0.1"/>
                    <Label text="Explainable Recommendations" style="-fx-font-size: 16px; -fx-text-fill: #FFFDF8; -fx-font-weight: bold;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Circle radius="20" fill="#FFFDF8" opacity="0.1"/>
                    <Label text="Community Safety Intelligence" style="-fx-font-size: 16px; -fx-text-fill: #FFFDF8; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Right Side: Login Card -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" style="-fx-background-color: #F8F2E7;" prefWidth="500">
            <VBox styleClass="floating-panel" spacing="25" maxWidth="420" alignment="CENTER">
                <VBox alignment="CENTER" spacing="5">
                    <Label text="Welcome Back" styleClass="title"/>
                    <Label text="Log in to continue to Safora" styleClass="subtitle"/>
                </VBox>

                <!-- Demo Credentials Helper -->
                <VBox spacing="5" style="-fx-background-color: rgba(46, 125, 50, 0.08); -fx-padding: 12px; -fx-background-radius: 12px; -fx-border-color: rgba(46, 125, 50, 0.2); -fx-border-radius: 12px;">
                    <Label text="Presentation Mode Available" style="-fx-font-weight: bold; -fx-text-fill: #2E7D32; -fx-font-size: 13px;"/>
                    <Label text="Use demo@safora.com / demo123" style="-fx-text-fill: #2E7D32; -fx-font-size: 12px;"/>
                </VBox>
                
                <VBox spacing="15" alignment="CENTER_LEFT" maxWidth="Infinity">
                    <VBox spacing="5">
                        <Label text="Email" styleClass="label" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="emailField" promptText="Enter your email" styleClass="input-field" maxWidth="Infinity"/>
                    </VBox>
                    
                    <VBox spacing="5">
                        <Label text="Password" styleClass="label" style="-fx-font-weight: bold;"/>
                        <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="input-field" maxWidth="Infinity"/>
                    </VBox>
                </VBox>
                
                <Label fx:id="errorLabel" text="" visible="false" style="-fx-text-fill: #C62828; -fx-font-weight: bold;"/>
                
                <Button text="Login" onAction="#handleLogin" maxWidth="Infinity" styleClass="primary-button"/>
                
                <HBox alignment="CENTER" spacing="5">
                    <Label text="Don't have an account?" styleClass="text-muted"/>
                    <Hyperlink text="Register" onAction="#navigateToRegister" style="-fx-text-fill: #6F2C2F; -fx-font-weight: bold; -fx-border-color: transparent;"/>
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
