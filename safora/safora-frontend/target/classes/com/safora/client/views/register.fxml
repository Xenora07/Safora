<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.effect.DropShadow?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:id="rootPane" fx:controller="com.safora.client.controllers.RegisterController" style="-fx-background-color: #F8F2E7;">
    
    <HBox>
        <!-- Left Side: Premium Branding (Exactly like Login) -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="30" style="-fx-background-color: linear-gradient(to bottom right, #6F2C2F, #4A1A1E);">
            <padding><Insets top="60" right="60" bottom="60" left="60"/></padding>
            
            <VBox spacing="10">
                <Label text="SAFORA" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 48px; -fx-font-weight: 900; -fx-text-fill: #FFFDF8; -fx-letter-spacing: 2px;"/>
                <Label text="Navigate Smarter. Arrive Safer." style="-fx-font-size: 18px; -fx-text-fill: #E7DCCF; -fx-font-weight: 300;"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <VBox spacing="15">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <StackPane>
                        <Circle radius="16" fill="#8C3A3E"/>
                        <Label text="🛡️" style="-fx-font-size: 14px;"/>
                    </StackPane>
                    <Label text="Context-Aware Routing" style="-fx-font-size: 16px; -fx-text-fill: #FFFDF8;"/>
                </HBox>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <StackPane>
                        <Circle radius="16" fill="#8C3A3E"/>
                        <Label text="👁️" style="-fx-font-size: 14px;"/>
                    </StackPane>
                    <Label text="Explainable Recommendations" style="-fx-font-size: 16px; -fx-text-fill: #FFFDF8;"/>
                </HBox>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <StackPane>
                        <Circle radius="16" fill="#8C3A3E"/>
                        <Label text="🤝" style="-fx-font-size: 14px;"/>
                    </StackPane>
                    <Label text="Community Verified Safety" style="-fx-font-size: 16px; -fx-text-fill: #FFFDF8;"/>
                </HBox>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <VBox spacing="5">
                <Label text="Presentation Mode Available" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #E7DCCF;"/>
                <Label text="Log in with demo@safora.com to preview" style="-fx-font-size: 12px; -fx-text-fill: #C4A485;"/>
            </VBox>
        </VBox>

        <!-- Right Side: Registration Form -->
        <VBox HBox.hgrow="ALWAYS" alignment="CENTER" style="-fx-background-color: #FFFDF8;" minWidth="450" maxWidth="500">
            <padding><Insets top="60" right="60" bottom="60" left="60"/></padding>
            
            <VBox spacing="30" maxWidth="380">
                <VBox spacing="5">
                    <Label text="Create Account" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2C2C2C;"/>
                    <Label text="Join the community today." style="-fx-font-size: 15px; -fx-text-fill: #737373;"/>
                </VBox>
                
                <VBox spacing="20">
                    <VBox spacing="8">
                        <Label text="Full Name" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <TextField fx:id="fullNameField" promptText="Enter your full name" style="-fx-font-size: 14px; -fx-padding: 12 16; -fx-background-color: #F8F2E7; -fx-background-radius: 8px; -fx-border-color: transparent; -fx-text-fill: #2C2C2C;"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Email" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <TextField fx:id="emailField" promptText="Enter your email" style="-fx-font-size: 14px; -fx-padding: 12 16; -fx-background-color: #F8F2E7; -fx-background-radius: 8px; -fx-border-color: transparent; -fx-text-fill: #2C2C2C;"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Phone" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <TextField fx:id="phoneField" promptText="Enter your phone number" style="-fx-font-size: 14px; -fx-padding: 12 16; -fx-background-color: #F8F2E7; -fx-background-radius: 8px; -fx-border-color: transparent; -fx-text-fill: #2C2C2C;"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Password" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <PasswordField fx:id="passwordField" promptText="Create a password (min 6 chars)" style="-fx-font-size: 14px; -fx-padding: 12 16; -fx-background-color: #F8F2E7; -fx-background-radius: 8px; -fx-border-color: transparent; -fx-text-fill: #2C2C2C;"/>
                        <Label fx:id="passwordStrengthLabel" text="" style="-fx-font-size: 12px;"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Confirm Password" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password" style="-fx-font-size: 14px; -fx-padding: 12 16; -fx-background-color: #F8F2E7; -fx-background-radius: 8px; -fx-border-color: transparent; -fx-text-fill: #2C2C2C;"/>
                    </VBox>
                </VBox>
                
                <Label fx:id="errorLabel" text="" visible="false" style="-fx-text-fill: #C62828; -fx-font-size: 13px;"/>
                
                <VBox spacing="15">
                    <Button text="Create Account" onAction="#handleRegister" maxWidth="Infinity" style="-fx-background-color: #6F2C2F; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 14 0; -fx-background-radius: 8px; -fx-cursor: hand;">
                        <effect>
                            <DropShadow color="rgba(111,44,47,0.3)" radius="10" offsetY="4"/>
                        </effect>
                    </Button>
                    
                    <HBox alignment="CENTER" spacing="5">
                        <Label text="Already have an account?" style="-fx-text-fill: #737373; -fx-font-size: 14px;"/>
                        <Hyperlink text="Login" onAction="#navigateToLogin" style="-fx-text-fill: #B08968; -fx-font-weight: bold; -fx-font-size: 14px; -fx-border-color: transparent; -fx-padding: 0;"/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
