<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.effect.DropShadow?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.safora.client.controllers.ReportIncidentDialogController" spacing="20" style="-fx-background-color: #FFFDF8; -fx-padding: 30px; -fx-border-radius: 12px; -fx-background-radius: 12px; -fx-border-color: #E7DCCF; -fx-border-width: 1px;" prefWidth="400">
    <effect>
        <DropShadow color="rgba(0,0,0,0.15)" radius="20" offsetY="10"/>
    </effect>
    
    <Label text="Report an Incident" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C2C2C;"/>
    
    <VBox spacing="5">
        <Label text="Incident Type" style="-fx-text-fill: #737373; -fx-font-size: 12px; -fx-font-weight: bold;"/>
        <ComboBox fx:id="categoryCombo" maxWidth="Infinity" promptText="Select Category" style="-fx-font-size: 14px; -fx-background-color: #F8F2E7; -fx-text-fill: #2C2C2C; -fx-border-color: #E7DCCF; -fx-border-radius: 6px; -fx-padding: 5px;">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="POOR_LIGHTING"/>
                    <String fx:value="CONSTRUCTION"/>
                    <String fx:value="SUSPICIOUS_ACTIVITY"/>
                    <String fx:value="POLICE_PRESENCE"/>
                    <String fx:value="HEAVY_TRAFFIC"/>
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>
    
    <VBox spacing="5">
        <Label text="Severity" style="-fx-text-fill: #737373; -fx-font-size: 12px; -fx-font-weight: bold;"/>
        <ComboBox fx:id="severityCombo" maxWidth="Infinity" promptText="Select Severity" style="-fx-font-size: 14px; -fx-background-color: #F8F2E7; -fx-text-fill: #2C2C2C; -fx-border-color: #E7DCCF; -fx-border-radius: 6px; -fx-padding: 5px;">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="LOW"/>
                    <String fx:value="MEDIUM"/>
                    <String fx:value="HIGH"/>
                    <String fx:value="CRITICAL"/>
                </FXCollections>
            </items>
        </ComboBox>
    </VBox>
    
    <VBox spacing="5">
        <Label text="Description (Optional)" style="-fx-text-fill: #737373; -fx-font-size: 12px; -fx-font-weight: bold;"/>
        <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true" promptText="Any additional details..." style="-fx-font-size: 14px; -fx-background-color: #F8F2E7; -fx-text-fill: #2C2C2C; -fx-border-color: #E7DCCF; -fx-border-radius: 6px;"/>
    </VBox>
    
    <Label fx:id="errorLabel" text="" visible="false" style="-fx-text-fill: #C62828; -fx-font-size: 13px;"/>
    
    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10px 0 0 0;">
        <Button text="Cancel" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-text-fill: #737373; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 10px 20px;"/>
        <Button text="Submit Report" onAction="#handleSubmit" style="-fx-background-color: #6F2C2F; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-background-radius: 8px; -fx-cursor: hand;">
            <effect>
                <DropShadow color="rgba(111,44,47,0.3)" radius="5" offsetY="2"/>
            </effect>
        </Button>
    </HBox>
</VBox>
