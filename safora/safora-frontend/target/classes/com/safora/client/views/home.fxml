<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import com.safora.client.components.MapViewComponent?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:id="rootPane" fx:controller="com.safora.client.controllers.HomeController" style="-fx-background-color: #F8F2E7;">
    
    <!-- Background Map -->
    <MapViewComponent fx:id="mapView" />

    <!-- Top Overlay (Greeting, Inputs, Profile) -->
    <VBox alignment="TOP_CENTER" pickOnBounds="false">
        <padding><Insets top="30" right="20" bottom="0" left="20"/></padding>
        <VBox maxWidth="600" styleClass="floating-panel" spacing="20">
            
            <!-- Tagline Badge -->
            <VBox fx:id="demoModeBadge" alignment="CENTER" visible="false" managed="false">
                <Label text="Safora" style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #6F2C2F;"/>
                <Label text="Navigate Smarter. Arrive Safer." style="-fx-font-size: 13px; -fx-text-fill: #B08968; -fx-font-style: italic;"/>
            </VBox>

            <!-- Header Row -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="greetingLabel" text="Good Evening," styleClass="subtitle" style="-fx-font-size: 14px; -fx-text-fill: #B08968;"/>
                    <Label fx:id="userNameLabel" text="User" styleClass="title" style="-fx-font-size: 22px;"/>
                </VBox>
                <VBox alignment="CENTER" style="-fx-cursor: hand;" onMouseClicked="#handleOpenProfile">
                    <Circle radius="24" fill="#D4A373"/>
                </VBox>
            </HBox>
            

            
            <!-- Location Inputs -->
            <VBox spacing="15">
                <!-- Current Location -->
                <VBox spacing="5">
                    <Label text="Current Location" styleClass="subtitle" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #6F2C2F;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="currentLocationField" promptText="Enter location or use GPS..." styleClass="input-field" HBox.hgrow="ALWAYS"/>
                        <Button text="Use GPS" onAction="#handleUseGPS" styleClass="secondary-button" style="-fx-padding: 10px 15px; -fx-font-size: 13px;"/>
                    </HBox>
                </VBox>

                <!-- Destination -->
                <VBox spacing="5">
                    <Label text="Destination" styleClass="subtitle" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #6F2C2F;"/>
                    <TextField fx:id="searchField" promptText="Where do you want to go?" styleClass="input-field" HBox.hgrow="ALWAYS"/>
                </VBox>
                
                <!-- Transport Mode Selector -->
                <VBox spacing="8">
                    <Label text="Transport Mode" styleClass="subtitle" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #6F2C2F;"/>
                    <HBox spacing="10">
                        <ToggleButton fx:id="modeDrive" text="🚗 Drive" selected="true" styleClass="transport-toggle"/>
                        <ToggleButton fx:id="modeWalk" text="🚶 Walk" styleClass="transport-toggle"/>
                        <ToggleButton fx:id="modeBike" text="🚲 Bike" styleClass="transport-toggle"/>
                        <ToggleButton fx:id="modeTransit" text="🚌 Transit" styleClass="transport-toggle"/>
                    </HBox>
                </VBox>
            </VBox>
            
            <Label fx:id="errorLabel" text="" visible="false" style="-fx-text-fill: #C62828; -fx-font-weight: bold;"/>
            <Button text="Analyze Journey" onAction="#handleAnalyzeJourney" maxWidth="Infinity" styleClass="primary-button"/>
        </VBox>
    </VBox>

    <!-- Bottom Floating Panel (Safe Places) -->
    <VBox alignment="BOTTOM_CENTER" pickOnBounds="false">
        <padding><Insets top="0" right="20" bottom="30" left="20"/></padding>
        
        <VBox maxWidth="600" styleClass="floating-panel" spacing="15">
            <Label text="Nearby Safe Places" styleClass="subtitle" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6F2C2F;"/>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button text="🚓 Police" onAction="#handleSafePlacePolice" styleClass="safe-place-chip" />
                <Button text="🏥 Hospital" onAction="#handleSafePlaceHospital" styleClass="safe-place-chip" />
                <Button text="🚇 Metro" onAction="#handleSafePlaceMetro" styleClass="safe-place-chip" />
            </HBox>
        </VBox>
    </VBox>
</StackPane>
